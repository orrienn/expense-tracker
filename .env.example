# Copy this file to .env and fill in the values. The .env file is not committed.

# PostgreSQL (used by docker-compose.yml and the backend)
DB_USER=expense_user
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expense_tracker

# JWT signing key (Base64, at least 32 bytes). Generate with: openssl rand -base64 32
JWT_SECRET=
# Optional: token lifetime (Spring Duration format: 30m, 1h, 1d). Default: 1h
# JWT_EXPIRATION=1h
